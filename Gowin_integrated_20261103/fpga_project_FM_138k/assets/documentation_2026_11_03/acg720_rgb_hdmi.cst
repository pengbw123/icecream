// ACG720 board J1 FPC40, TFT V3.0 800x480 RGB565.
// GPIO0 bank VCCIO must be set to 3.3 V for external MIDI/audio/LED signals.
IO_LOC "clk" Y18;
// P4 OV5640, pinout from the supplied GW5AT138K ch59 board reference.
// The generic PDF differs on D0/D1/D3/D6 and omits the FPGA PWDN net.
IO_LOC "camera_pclk" B1;
IO_LOC "camera_href" A1;
IO_LOC "camera_vsync" B2;
IO_LOC "camera_data[0]" J2;
