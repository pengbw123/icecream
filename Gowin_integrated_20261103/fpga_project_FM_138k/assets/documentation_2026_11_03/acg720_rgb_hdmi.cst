IO_PORT "camera_data[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "camera_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "camera_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4;
IO_PORT "camera_xclk" IO_TYPE=LVCMOS33 DRIVE=8;
