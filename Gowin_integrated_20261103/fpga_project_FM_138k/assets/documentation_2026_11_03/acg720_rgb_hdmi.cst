// Optional CH376S pins; default 25K bridge build holds SPI idle.
IO_LOC "ch376_cs_n" A18; // P7-5 -> D3/SCS
IO_PORT "ch376_cs_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ch376_sck" F13; // P7-7 -> D5/SCK
IO_PORT "ch376_sck" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ch376_mosi" F14; // P7-8 -> D6/SDI
IO_PORT "ch376_mosi" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "ch376_miso" C13; // P7-13 <- D7/SDO
IO_PORT "ch376_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "ch376_int_n" B13; // P7-14 <- INT#
IO_PORT "ch376_int_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
