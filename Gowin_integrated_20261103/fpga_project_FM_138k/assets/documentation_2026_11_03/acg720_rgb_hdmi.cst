IO_LOC "camera_sda" L18;
IO_LOC "camera_xclk" M17;
IO_LOC "camera_reset_n" N20;
IO_LOC "camera_pwdn" L1;
IO_PORT "camera_pclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "camera_href" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "camera_vsync" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
