IO_LOC "sd_miso" R1;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Imported dedicated JDY UART and S0/S1 tutorial controls; existing PC UART unchanged.
IO_LOC "bluetooth_rx_pin" E13;
IO_PORT "bluetooth_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "bluetooth_tx_pin" E14;
IO_PORT "bluetooth_tx_pin" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "tutorial_start_n" F15;
IO_PORT "tutorial_start_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "tutorial_stop_n" A20;
IO_PORT "tutorial_stop_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Dedicated latency pulse, GPIO0_12 on P7 pin 15; GPIO0 VCCIO = 3.3V.
IO_LOC "latency_probe" D14;
IO_PORT "latency_probe" IO_TYPE=LVCMOS33 DRIVE=8;
