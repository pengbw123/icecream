// ACG720 board J1 FPC40, TFT V3.0 800x480 RGB565.
// GPIO0 bank VCCIO must be set to 3.3 V for external MIDI/audio/LED signals.
IO_LOC "clk" Y18;
IO_LOC "reset_button_n" B21;
IO_LOC "uart_rx_pin" J21;
IO_LOC "uart_tx_pin" M15;
IO_LOC "i2s_bclk" A13; // P7-1
IO_LOC "i2s_lrclk" A14; // P7-2
IO_LOC "i2s_din" A15; // P7-3
IO_LOC "bridge_uart_rx_pin" A16; // P7-4, 1 Mbaud input from 25K
IO_LOC "ws2812_data" A19; // P7-6
IO_LOC "status_led[0]" M22;
IO_LOC "status_led[1]" N22;
IO_LOC "status_led[2]" L21;
IO_LOC "status_led[3]" K21;
IO_LOC "status_led[4]" K22;
IO_LOC "lcd_pclk" AB20;
IO_LOC "lcd_de" AB22;
IO_LOC "lcd_hsync" V19;
IO_LOC "lcd_vsync" Y19;
IO_LOC "lcd_bl" AB21;
IO_LOC "lcd_r[0]" L6;
IO_LOC "lcd_r[1]" N15;
IO_LOC "lcd_r[2]" R17;
IO_LOC "lcd_r[3]" P16;
IO_LOC "lcd_r[4]" N14;
IO_LOC "lcd_g[0]" N13;
IO_LOC "lcd_g[1]" R16;
IO_LOC "lcd_g[2]" P15;
IO_LOC "lcd_g[3]" P17;
IO_LOC "lcd_g[4]" N17;
IO_LOC "lcd_g[5]" T18;
IO_LOC "lcd_b[0]" R18;
IO_LOC "lcd_b[1]" R14;
IO_LOC "lcd_b[2]" P14;
IO_LOC "lcd_b[3]" U18;
IO_LOC "lcd_b[4]" U17;
IO_LOC "tp_scl" T21;
IO_LOC "tp_sda" T20;
IO_LOC "tp_int" P20;
IO_LOC "tp_rst" Y21;
// HDMI1 connector J6. Paired 3.3 V ODDR outputs share Bank 7 with RGB.
IO_LOC "hdmi_clk_p" K4;
IO_LOC "hdmi_clk_n" J4;
IO_LOC "hdmi_data_p[0]" L3;
IO_LOC "hdmi_data_n[0]" K3;
IO_LOC "hdmi_data_p[1]" L5;
IO_LOC "hdmi_data_n[1]" L4;
IO_LOC "hdmi_data_p[2]" M3;
IO_LOC "hdmi_data_n[2]" M2;
IO_LOC "hdmi_oe" H5;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "hdmi_clk_p" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_clk_n" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_p[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_n[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_p[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_n[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_p[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_data_n[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "hdmi_oe" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "reset_button_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "bridge_uart_rx_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_PORT "i2s_bclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_lrclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "i2s_din" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "ws2812_data" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "status_led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "status_led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "status_led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "status_led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "status_led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_pclk" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_bl" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "tp_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "tp_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "tp_int" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "tp_rst" IO_TYPE=LVCMOS33 DRIVE=8;
